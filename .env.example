# Upstream Hermes webui this bridge fronts
HERMES_WEBUI_URL=http://127.0.0.1:9119
HERMES_WEBUI_PASSWORD=change-me

# Shared secret the Android app sends as: Authorization: Bearer <token>
# Generate a strong one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# Background push (ntfy / UnifiedPush). Leave NTFY_TOPIC empty to disable push.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
