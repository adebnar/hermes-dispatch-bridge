# Upstream hermes-agent dashboard this bridge fronts (REST + JSON-RPC WebSocket)
HERMES_URL=http://127.0.0.1:9119
# Dashboard session token (X-Hermes-Session-Token). Find it in the dashboard
# HTML as window.__HERMES_SESSION_TOKEN__, or from your loopback config.
HERMES_TOKEN=

# Shared secret the Android app sends as: Authorization: Bearer <token>
# Generate a strong one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# Background push (ntfy / UnifiedPush). Leave NTFY_TOPIC empty to disable the
# static topic; per-device endpoints are registered at runtime via /v1/push.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

# Inbox: where hermes-agent saved local cron deliverables live. The bridge reads
# {HERMES_DIR}/cron/output and {HERMES_DIR}/profiles/*/cron/output and serves
# them at /v1/inbox. Defaults to ~/.hermes — match your hermes install.
HERMES_DIR=~/.hermes
# How often (seconds) to scan for new deliverables and push Inbox alerts.
INBOX_POLL_SECONDS=30

# Where the bridge persists state across restarts (push registrations, the E2EE
# push key, Inbox alert subscriptions). Relative paths are under the bridge dir.
STATE_DIR=state
