<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.hermesdispatch.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__BRIDGE_DIR__/scripts/run-bridge.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__BRIDGE_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__BRIDGE_DIR__/bridge.log</string>
  <key>StandardErrorPath</key><string>__BRIDGE_DIR__/bridge.log</string>
</dict>
</plist>
